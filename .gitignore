# Laravel and deployment state
/vendor/
/.phpunit.cache/
.phpunit.result.cache
/bootstrap/cache/*.php
# Keep the Laravel directory placeholders versioned so fresh clones and CI
# get bootstrap/cache and the storage tree; runtime files stay ignored.
/storage/*
!/storage/app/
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/
/storage/app/public/*
!/storage/app/public/.gitignore
!/storage/framework/
/storage/framework/*
!/storage/framework/cache/
/storage/framework/cache/*
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
!/storage/framework/testing/
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
!/storage/framework/views/
/storage/framework/views/*
!/storage/framework/views/.gitignore
!/storage/logs/
/storage/logs/*
!/storage/logs/.gitignore
/deploy/artifacts/
/deploy/local/
/.env.*
!/.env.example
/.phpunit-watcher.yml
/auth.json
__pycache__/
*.pyc
